classDiagram
    class Task {
        +UUID id
        +UUID pet_id
        +String description
        +int duration_minutes
        +String priority_level
        +Frequency frequency
        +time scheduled_time
        +Date scheduled_date
        +Set~int~ days_of_week
        +bool completed
        +Set~Date~ completed_dates
        +is_due_on(day)
        +occurs_on(day)
        +mark_complete(completed_on)
    }

    class Pet {
        +UUID id
        +String name
        +String species
        +int age
        +List~Task~ care_tasks
        +add_task(task)
        +edit_task(task_id, updated_task)
        +remove_task(task_id)
    }

    class Owner {
        +UUID id
        +String name
        +String preferences
        +int time_availability_minutes
        +List~Pet~ pets
        +add_pet(pet)
        +get_pet(pet_id)
        +remove_pet(pet_id)
        +add_task(pet_id, task)
        +edit_task(pet_id, task_id, updated_task)
        +remove_task(pet_id, task_id)
        +get_all_tasks()
    }

    class Scheduler {
        +get_tasks(owner, plan_date, include_completed)
        +organize_tasks(tasks)
        +generate_schedule(owner, plan_date, available_minutes)
        +mark_task_complete(owner, task_id, completed_on)
    }

    class Frequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
    }

    Owner "1" o-- "0..*" Pet : manages
    Pet "1" *-- "0..*" Task : owns
    Task --> Frequency : repeats
    Scheduler ..> Owner : retrieves all tasks from
    Scheduler ..> Task : organizes and completes
