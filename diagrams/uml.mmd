classDiagram
    class Owner {
        +String name
        +String preferences
        +int timeAvailabilityMinutes
        +addTask(task)
        +editTask(task)
        +removeTask(task)
        +addPet(pet)
        +editPet(pet)
    }

    class Pet {
        +String name
        +String species
        +int age
        +List~CareTask~ preferredTasks
    }

    class CareTask {
        +String name
        +String category
        +int durationMinutes
        +String priorityLevel
        +String scheduledTimeOccurrence
    }

    class DailyPlan {
        +List~CareTask~ scheduledTasks
        +Date date
        +int totalDurationMinutes
        +String reasoning
        +generatePlan(owner, pet, tasks)
        +sortTasksByPriority(tasks)
        +sortTasksByTime(tasks, availableMinutes)
        +explainReasoning()
    }

    Owner "1" o-- "0..*" Pet : cares for
    Owner "1" --> "0..*" DailyPlan : creates
    Pet "1" --> "0..*" CareTask : has care tasks
    DailyPlan "1" o-- "0..*" CareTask : schedules
